{% extends "_layouts/cp" %}

{% set selectedSubnavItem = 'attention' %}
{% set title = 'orderTab.attentionNeeded'|t('shipments') %}

{% set crumbs = [
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/shipments') },
] %}

{% block content %}
	<h2>{{ 'orderTab.underAllocatedOrders'|t('shipments') }}</h2>

	{% if orders|length == 0 %}
		<div class="pane shipments-attention-empty">
			{% if trackedOrderCount == 0 %}
				<p class="light">{{ 'orderTab.noTrackedOrders'|t('shipments')|md(inlineOnly=true) }}</p>
			{% else %}
				<p class="light">{{ 'orderTab.noAttentionNeeded'|t('shipments') }}</p>
			{% endif %}
		</div>
	{% else %}
		<p class="light">{{ 'orderTab.ordersNeedAttentionCount'|t('shipments', { n: orders|length }) }}</p>

		<table class="data fullwidth shipments-attention-table">
			<thead>
				<tr>
					<th>{{ 'shipmentEdit.order'|t('shipments') }}</th>
					<th>{{ 'shipmentEdit.statusHistory.date'|t('shipments') }}</th>
					<th>{{ 'emails.recipientType.customer'|t('shipments') }}</th>
					<th>{{ 'orderTab.missing'|t('shipments') }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for row in orders %}
					{% set order = row.order %}
					<tr>
						<td>
							<a href="{{ order.cpEditUrl }}"><strong>{{ order.reference ?: ('#' ~ order.number) }}</strong></a>
						</td>
						<td>{% if order.dateOrdered %}{{ order.dateOrdered|datetime('short') }}{% else %}<span class="light">-</span>{% endif %}</td>
						<td>
							{% set customer = order.getCustomer() %}
							{% if customer %}
								<a href="{{ customer.cpEditUrl }}">{{ customer.name ?? customer.email ?? customer.username }}</a>
							{% else %}
								<span class="light">-</span>
							{% endif %}
						</td>
						<td>
							{{ 'orderTab.lineItemCount'|t('shipments', { n: row.missing|length }) }}
						</td>
						<td class="thin">
							<a class="btn small" href="{{ order.cpEditUrl ~ '#orderShipmentsTab' }}">{{ 'orderTab.fix'|t('shipments') }}</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endif %}

	<h2 class="shipments-attention-section-heading">{{ 'settings.integrations.unmappedStatusesHeading'|t('shipments') }}</h2>

	{% if unmapped|length == 0 %}
		<div class="pane shipments-attention-empty">
			<p class="light">{{ 'settings.integrations.noUnmappedCodes'|t('shipments') }}</p>
		</div>
	{% else %}
		<p class="light">{{ 'settings.integrations.unmappedCodesIntro'|t('shipments') }}</p>

		<table class="data fullwidth shipments-attention-table">
			<thead>
				<tr>
					<th>{{ 'settings.integrations.integration'|t('shipments') }}</th>
					<th>{{ 'settings.integrations.type'|t('shipments') }}</th>
					<th>{{ 'settings.integrations.externalCode'|t('shipments') }}</th>
					<th class="thin">{{ 'settings.integrations.occurrences'|t('shipments') }}</th>
					<th>{{ 'settings.integrations.lastSeen'|t('shipments') }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for row in unmapped %}
					<tr>
						<td><strong>{{ row.integration.name }}</strong></td>
						<td>{{ row.axis.label() }}</td>
						<td><code>{{ row.externalCode }}</code></td>
						<td class="thin">{{ row.occurrenceCount }}</td>
						<td>{% if row.dateLastSeen %}{{ row.dateLastSeen|date('short') }}{% else %}<span class="light">-</span>{% endif %}</td>
						<td class="thin">
							<a class="btn small" href="{{ url('shipments/settings/integrations/' ~ row.integration.id ~ '/status-maps') }}">{{ 'settings.integrations.map'|t('shipments') }}</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endif %}
{% endblock %}
