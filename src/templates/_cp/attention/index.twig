{% extends "_layouts/cp" %}

{% set selectedSubnavItem = 'attention' %}
{% set title = 'orderTab.attentionNeeded'|t('shipments') %}

{% set crumbs = [
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/shipments') },
] %}

{% block content %}
	<h2>{{ 'orderTab.underAllocatedOrders'|t('shipments') }}</h2>

	{% if totalOrders == 0 %}
		<div class="pane shipments-attention-empty">
			{% if trackedOrderCount == 0 %}
				<p class="light">{{ 'orderTab.noTrackedOrders'|t('shipments')|md(inlineOnly=true) }}</p>
			{% else %}
				<p class="light">{{ 'orderTab.noAttentionNeeded'|t('shipments') }}</p>
			{% endif %}
		</div>
	{% else %}
		<p class="light">{{ 'orderTab.ordersNeedAttentionCount'|t('shipments', { n: totalOrders }) }}</p>

		<table class="data fullwidth shipments-attention-table">
			<thead>
				<tr>
					<th>{{ 'shipmentEdit.order'|t('shipments') }}</th>
					<th>{{ 'shipmentEdit.statusHistory.date'|t('shipments') }}</th>
					<th>{{ 'emails.recipientType.customer'|t('shipments') }}</th>
					<th>{{ 'orderTab.missing'|t('shipments') }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for row in orders %}
					{% set order = row.order %}
					<tr>
						<td>
							<a href="{{ order.cpEditUrl }}"><strong>{{ order.reference ?: ('#' ~ order.number) }}</strong></a>
						</td>
						<td>{% if order.dateOrdered %}{{ order.dateOrdered|datetime('short') }}{% else %}<span class="light">-</span>{% endif %}</td>
						<td>
							{% set customer = order.getCustomer() %}
							{% if customer %}
								<a href="{{ customer.cpEditUrl }}">{{ customer.name ?? customer.email ?? customer.username }}</a>
							{% else %}
								<span class="light">-</span>
							{% endif %}
						</td>
						<td>
							{{ 'orderTab.lineItemCount'|t('shipments', { n: row.missing|length }) }}
						</td>
						<td class="thin">
							<a class="btn small" href="{{ order.cpEditUrl ~ '#orderShipmentsTab' }}">{{ 'orderTab.fix'|t('shipments') }}</a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		{% if totalPages > 1 %}
			<nav class="shipments-attention-pagination">
				{% if currentPage > 1 %}
					<a class="btn" href="{{ url('shipments/attention-needed', { page: currentPage - 1 }) }}">{{ 'pagination.previous'|t('shipments') }}</a>
				{% endif %}
				<span class="light">{{ 'pagination.pageOf'|t('shipments', { current: currentPage, total: totalPages }) }}</span>
				{% if currentPage < totalPages %}
					<a class="btn" href="{{ url('shipments/attention-needed', { page: currentPage + 1 }) }}">{{ 'pagination.next'|t('shipments') }}</a>
				{% endif %}
			</nav>
		{% endif %}
	{% endif %}
	{% include 'shipments/_includes/plugin-footer' %}
{% endblock %}
