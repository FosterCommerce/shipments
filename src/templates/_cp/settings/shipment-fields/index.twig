{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set selectedItem = 'shipment-fields' %}
{% set title = 'Shipment fields'|t('shipments') %}
{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'Shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% block content %}
	{% if not readOnly %}
		{{ actionInput('shipments/shipment-fields/save') }}
	{% endif %}

	<p>{{ 'Add custom fields that admins can fill in on each shipment. Layout edits sync via project config.'|t('shipments') }}</p>

	{{ forms.fieldLayoutDesignerField({
		fieldLayout: fieldLayout,
		disabled: readOnly,
	}) }}
{% endblock %}
