{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{#
	Shipment edit page: full-page CP form with permanent tabs. Status and tracking fields
	are editable inline. Registers `ShipmentsCpAsset` from the controller.

	@var statusOptions array<string, string>
#}

{% set fullPageForm = true %}

{% set crumbs = [
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/shipments') },
	{ label: order.reference ?: order.number, url: order.cpEditUrl },
] %}

{% set fieldLayout = shipment.getFieldLayout() %}
{% set fieldLayoutForm = fieldLayout ? fieldLayout.createForm(shipment) : null %}
{% set customFieldTabs = [] %}
{% if fieldLayoutForm %}
	{% for layoutTab in fieldLayoutForm.tabs %}
		{% if layoutTab.getContent() is not empty %}
			{% set customFieldTabs = customFieldTabs|merge([layoutTab]) %}
		{% endif %}
	{% endfor %}
{% endif %}

{% set tabs = {
	shipmentDetails: { label: 'nav.details'|t('shipments'), url: '#shipment-details' },
	lineItems: { label: 'shipmentEdit.lineItems.heading'|t('shipments'), url: '#line-items' },
	integrationReferences: { label: 'shipmentEdit.references.heading'|t('shipments'), url: '#integration-references' },
	statusHistory: { label: 'shipmentEdit.statusHistory.heading'|t('shipments'), url: '#status-history' },
} %}
{% for layoutTab in customFieldTabs %}
	{% set tabs = tabs|merge({
		(layoutTab.getId()): { label: layoutTab.getName(), url: '#' ~ layoutTab.getId() },
	}) %}
{% endfor %}
{% set selectedTab = selectedTab ?? 'shipmentDetails' %}

{% set statusSelectOptions = [] %}
{% for code, label in statusOptions %}
	{% set statusSelectOptions = statusSelectOptions|merge([{ label: label, value: code }]) %}
{% endfor %}

{% block actionButton %}
	<div class="btngroup submit">
		<button type="submit" class="btn submit">{{ 'common.save'|t('shipments') }}</button>
		<button type="button" class="btn submit menubtn" title="{{ 'common.actions'|t('shipments') }}"></button>
		<div class="menu">
			<ul>
				<li>
					<a class="formsubmit error"
						data-action="shipments/shipments/delete"
						data-redirect="{{ order.cpEditUrl|hash }}"
						data-confirm="{{ 'shipmentEdit.deleteConfirm'|t('shipments') }}">
						{{ 'common.delete'|t('shipments') }}
					</a>
				</li>
			</ul>
		</div>
	</div>
{% endblock %}

{% block details %}
	<div class="meta">
		{{ forms.lightswitchField({
			label: 'shipmentEdit.enabled'|t('shipments'),
			instructions: 'shipmentEdit.disableReturnsLineItems'|t('shipments'),
			id: 'enabled',
			name: 'enabled',
			on: shipment.enabled,
		}) }}
	</div>

	<div class="meta read-only">
		<div class="data">
			<h5 class="heading">{{ 'index.column.reference'|t('shipments') }}</h5>
			<div class="value"><code>{{ shipment.reference }}</code></div>
		</div>
		<div class="data">
			<h5 class="heading">{{ 'shipmentEdit.order'|t('shipments') }}</h5>
			<div class="value">
				<a href="{{ order.cpEditUrl }}">{{ order.reference ?: ('#' ~ order.number) }}</a>
			</div>
		</div>
		{% set orderShippingMethodName = order.shippingMethodName ?? order.getShippingMethod().getName() ?? null %}
		{% if orderShippingMethodName %}
			<div class="data">
				<h5 class="heading">{{ 'shipmentEdit.tracking.shippingMethod'|t('shipments') }}</h5>
				<div class="value">{{ orderShippingMethodName }}</div>
			</div>
		{% endif %}
		{% if shipment.dateShipped %}
			<div class="data">
				<h5 class="heading">{{ 'shipmentEdit.statusHistory.dateShipped'|t('shipments') }}</h5>
				<div class="value">{{ shipment.dateShipped|datetime('short') }}</div>
			</div>
		{% endif %}
		{% if shipment.dateCreated %}
			<div class="data">
				<h5 class="heading">{{ 'status.created'|t('shipments') }}</h5>
				<div class="value">{{ shipment.dateCreated|datetime('short') }}</div>
			</div>
		{% endif %}
		{% if shipment.dateUpdated %}
			<div class="data">
				<h5 class="heading">{{ 'index.column.updated'|t('shipments') }}</h5>
				<div class="value">{{ shipment.dateUpdated|datetime('short') }}</div>
			</div>
		{% endif %}
	</div>

	{% if pushableIntegrations|length and currentUser.can(constant('fostercommerce\\shipments\\Plugin::PERMISSION_PUSH')) %}
		<fieldset>
			<legend class="h6">{{ 'nav.integrations'|t('shipments') }}</legend>
			<div class="meta">
			{% for integration in pushableIntegrations %}
				<div class="field">
					<div class="input ltr">
						<button type="button" class="btn shipments-push-integration" data-shipment-id="{{ shipment.id }}" data-integration-id="{{ integration.id }}">
							{{ 'shipmentEdit.pushTo'|t('shipments', { name: integration.name }) }}
						</button>
					</div>
				</div>
			{% endfor %}
			{% if shipment.dateLastPushAttempt %}
				<p class="light shipments-push-meta">
					{{ 'settings.integrations.lastAttempt'|t('shipments') }}:
					{{ shipment.dateLastPushAttempt|datetime('short') }}
					{% if shipment.lastPushAttemptError %}
						<br><code class="error">{{ shipment.lastPushAttemptError }}</code>
					{% endif %}
				</p>
			{% endif %}
			</div>
		</fieldset>
	{% endif %}
{% endblock %}

{% block content %}
	{{ actionInput('shipments/shipments/save') }}
	{{ redirectInput(shipment.cpEditUrl) }}
	<input type="hidden" name="id" value="{{ shipment.id }}">

	{# Details tab #}
	<div id="shipment-details">
		<h2>{{ 'shipmentEdit.statusLabel'|t('shipments') }}</h2>

		{{ forms.selectField({
			label: 'shipmentEdit.statusLabel'|t('shipments'),
			instructions: 'shipmentEdit.statusHelp'|t('shipments'),
			id: 'status',
			name: 'status',
			value: shipment.status,
			options: statusSelectOptions,
		}) }}

		{{ forms.textareaField({
			label: 'shipmentEdit.statusChangeNote'|t('shipments'),
			instructions: 'shipmentEdit.statusNoteHelp'|t('shipments'),
			id: 'statusMessage',
			name: 'statusMessage',
			class: 'fullwidth',
			rows: 2,
		}) }}

		{{ forms.dateTimeField({
			label: 'shipmentEdit.targetShipDate'|t('shipments'),
			instructions: 'shipmentEdit.targetShipDateHelp'|t('shipments'),
			id: 'dateScheduledShip',
			name: 'dateScheduledShip',
			value: shipment.dateScheduledShip,
		}) }}

		{{ forms.textareaField({
			label: 'shipmentEdit.note'|t('shipments'),
			instructions: 'shipmentEdit.fulfillmentNoteHelp'|t('shipments'),
			id: 'fulfillmentNotes',
			name: 'fulfillmentNotes',
			class: 'fullwidth',
			rows: 3,
			value: shipment.fulfillmentNotes,
		}) }}

		<hr>

		<h2>{{ 'shipmentEdit.tracking.heading'|t('shipments') }}</h2>

		<div class="flex shipments-field-row">
			<div class="flex-grow">
				{{ forms.textField({
					label: 'shipmentEdit.tracking.carrier'|t('shipments'),
					id: 'carrier',
					name: 'carrier',
					class: 'fullwidth',
					value: shipment.carrier,
				}) }}
			</div>
			<div class="flex-grow">
				{{ forms.textField({
					label: 'shipmentEdit.tracking.service'|t('shipments'),
					id: 'service',
					name: 'service',
					class: 'fullwidth',
					value: shipment.service,
				}) }}
			</div>
		</div>

		<div class="flex shipments-field-row">
			<div class="flex-grow">
				{{ forms.textField({
					label: 'shipmentEdit.tracking.number'|t('shipments'),
					id: 'trackingNumber',
					name: 'trackingNumber',
					class: 'fullwidth',
					value: shipment.trackingNumber,
				}) }}
			</div>
			<div class="flex-grow">
				{{ forms.textField({
					label: 'shipmentEdit.tracking.url'|t('shipments'),
					id: 'trackingUrl',
					name: 'trackingUrl',
					class: 'fullwidth ltr',
					value: shipment.trackingUrl,
				}) }}
			</div>
		</div>

		{{ forms.textareaField({
			label: 'shipmentEdit.note'|t('shipments'),
			instructions: 'shipmentEdit.shippingNoteHelp'|t('shipments'),
			id: 'shippingNotes',
			name: 'shippingNotes',
			class: 'fullwidth',
			rows: 3,
			value: shipment.shippingNotes,
		}) }}
	</div>

	{# Line items tab #}
	{# Editing is gated to enabled, non-trashed shipments: a disabled or trashed shipment's line
	   items don't count toward allocation, so the "available" math and overflow guard would be
	   incoherent. In that state the tab is read-only. #}
	{% set lineItemsEditable = shipment.enabled and not shipment.trashed %}
	<div id="line-items" class="hidden">
		{% if shipment.lineItems|length %}
			{% if lineItemsEditable %}
				<p class="light shipments-membership-note">{{ 'shipmentEdit.lineItems.adjustIntro'|t('shipments') }}</p>
			{% else %}
				<p class="light shipments-membership-note">{{ 'shipmentEdit.lineItems.readOnlyNote'|t('shipments') }}</p>
			{% endif %}

			{# No nested `<form>`: this tab lives inside the page's full-page form, and HTML5 strips
			   nested forms. The save button posts via `Craft.sendActionRequest`, like the order tab. #}
			<div id="shipments-line-items-editor" data-shipment-id="{{ shipment.id }}">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>{{ 'shipmentEdit.lineItems.lineItem'|t('shipments') }}</th>
							{% if lineItemsEditable %}<th class="thin">{{ 'shipmentEdit.lineItems.available'|t('shipments') }}</th>{% endif %}
							<th class="thin">{{ 'shipmentEdit.lineItems.qty'|t('shipments') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for shipmentLineItem in shipment.lineItems %}
							{% set orderLineItem = null %}
							{% for candidate in order.getLineItems() %}
								{% if candidate.id == shipmentLineItem.lineItemId %}
									{% set orderLineItem = candidate %}
								{% endif %}
							{% endfor %}
							{% set availableQty = shipmentLineItem.qty + (unallocatedPool[shipmentLineItem.lineItemId] ?? 0) %}
							<tr data-line-item-id="{{ shipmentLineItem.lineItemId }}">
								<td>
									{% if orderLineItem %}
										<strong>{{ orderLineItem.description ?? orderLineItem.snapshot.title ?? orderLineItem.sku ?? orderLineItem.id }}</strong>
										{% if orderLineItem.sku %}
											<br><code class="light">{{ orderLineItem.sku }}</code>
										{% endif %}
										<br><span class="light shipments-line-item-id-hint">{{ 'shipmentEdit.lineItems.lineItemId'|t('shipments') }}: <code>{{ shipmentLineItem.lineItemId }}</code></span>
									{% else %}
										<code>#{{ shipmentLineItem.lineItemId }}</code>
										<br><span class="light shipments-line-item-id-hint">{{ 'shipmentEdit.lineItems.noLongerOnOrder'|t('shipments') }}</span>
									{% endif %}
								</td>
								{% if lineItemsEditable %}
									<td>{{ availableQty }}</td>
									<td>
										<input type="number" class="text shipments-line-item-qty" min="0" max="{{ availableQty }}" step="1"
											name="lineItems[{{ shipmentLineItem.lineItemId }}]" value="{{ shipmentLineItem.qty }}"
											data-line-item-id="{{ shipmentLineItem.lineItemId }}">
									</td>
								{% else %}
									<td><strong>{{ shipmentLineItem.qty }}</strong></td>
								{% endif %}
							</tr>
						{% endfor %}
					</tbody>
				</table>

				{% if lineItemsEditable %}
					<div class="buttons shipments-buttons-row">
						<button type="button" class="btn submit" id="shipments-save-line-items" data-shipment-id="{{ shipment.id }}">{{ 'shipmentEdit.lineItems.save'|t('shipments') }}</button>
					</div>
				{% endif %}
			</div>
		{% else %}
			<p class="light">{{ 'shipmentEdit.lineItems.noneOnShipment'|t('shipments') }}</p>
		{% endif %}
	</div>

	{# Integration references tab #}
	<div id="integration-references" class="hidden">
		{% if integrations|length %}
			<p class="light">{{ 'shipmentEdit.references.intro'|t('shipments') }}</p>

			{% set sourceOptions = [] %}
			{% for source in integrations %}
				{% set sourceOptions = sourceOptions|merge([{ label: source.name, value: source.id }]) %}
			{% endfor %}

			<div id="shipments-integration-references">
				{% for reference in shipment.integrationReferences %}
					<div class="shipments-integration-reference">
						<input type="hidden" name="integrationReferences[{{ loop.index0 }}][id]" value="{{ reference.id }}">
						{{ forms.selectField({
							label: 'settings.integrations.integration'|t('shipments'),
							name: 'integrationReferences[' ~ loop.index0 ~ '][integrationId]',
							value: reference.integrationId,
							options: sourceOptions,
						}) }}
						{{ forms.textField({
							label: 'shipmentEdit.references.referenceId'|t('shipments'),
							name: 'integrationReferences[' ~ loop.index0 ~ '][externalId]',
							class: 'ltr',
							value: reference.externalId,
						}) }}
						{{ forms.textField({
							label: 'shipmentEdit.references.urlOverride'|t('shipments'),
							instructions: 'shipmentEdit.references.urlOverrideHelp'|t('shipments'),
							name: 'integrationReferences[' ~ loop.index0 ~ '][url]',
							class: 'ltr',
							value: reference.url,
						}) }}
						<button type="button" class="btn shipments-remove-reference">{{ 'shipmentEdit.references.remove'|t('shipments') }}</button>
					</div>
				{% endfor %}
			</div>

			<div class="shipments-buttons-row">
				<button type="button" class="btn add icon" id="shipments-add-reference">{{ 'shipmentEdit.references.add'|t('shipments') }}</button>
			</div>

			<template id="shipments-reference-template">
				<div class="shipments-integration-reference">
					<input type="hidden" name="integrationReferences[__INDEX__][id]" value="">
					{{ forms.selectField({
						label: 'settings.integrations.integration'|t('shipments'),
						name: 'integrationReferences[__INDEX__][integrationId]',
						options: sourceOptions,
					}) }}
					{{ forms.textField({
						label: 'shipmentEdit.references.referenceId'|t('shipments'),
						name: 'integrationReferences[__INDEX__][externalId]',
						class: 'ltr',
					}) }}
					{{ forms.textField({
						label: 'shipmentEdit.references.urlOverride'|t('shipments'),
						instructions: 'shipmentEdit.references.urlOverrideHelp'|t('shipments'),
						name: 'integrationReferences[__INDEX__][url]',
						class: 'ltr',
					}) }}
					<button type="button" class="btn shipments-remove-reference">{{ 'shipmentEdit.references.remove'|t('shipments') }}</button>
				</div>
			</template>
		{% else %}
			<p class="light">
				{{ 'integrations.emptyState.noneConfigured'|t('shipments') }}
				<a href="{{ url('shipments/settings/integrations') }}">{{ 'integrations.emptyState.configureOne'|t('shipments') }}</a>.
			</p>
		{% endif %}
	</div>

	{# Status history tab #}
	<div id="status-history" class="hidden">
		{% if statusHistory|length %}
			<table class="data fullwidth" id="shipments-history-table">
				<thead>
					<tr>
						<th>{{ 'shipmentEdit.statusHistory.from'|t('shipments') }}</th>
						<th>{{ 'emails.field.to'|t('shipments') }}</th>
						<th>{{ 'shipmentEdit.statusHistory.updatedBy'|t('shipments') }}</th>
						<th>{{ 'shipmentEdit.statusHistory.source'|t('shipments') }}</th>
						<th>{{ 'shipmentEdit.statusHistory.date'|t('shipments') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for entry in statusHistory %}
						<tr>
							<td>
								{% if entry.fromCode %}
									{{ entry.fromCode.label() }}
								{% else %}
									<span class="light">-</span>
								{% endif %}
							</td>
							<td>
								{% if entry.toCode %}
									<strong>{{ entry.toCode.label() }}</strong>
								{% else %}
									<span class="light">-</span>
								{% endif %}
								{% if entry.message %}
									<div class="light shipments-history-message">{{ entry.message }}</div>
								{% endif %}
							</td>
							<td>
								{% if entry.user %}
									<a href="{{ entry.user.cpEditUrl }}">{{ entry.user.name ?? entry.user.username }}</a>
								{% else %}
									<span class="light">{{ 'shipmentEdit.statusHistory.sourceSystem'|t('shipments') }}</span>
								{% endif %}
							</td>
							<td>
								{% if entry.sourceIntegration %}
									<a href="{{ entry.sourceIntegration.cpEditUrl }}">{{ entry.sourceIntegration.name }}</a>
									{% if entry.sourceExternalCode %}
										<br><code class="light">{{ entry.sourceExternalCode }}</code>
									{% endif %}
								{% else %}
									<span class="light">{{ 'shipmentEdit.statusHistory.sourceCp'|t('shipments') }}</span>
								{% endif %}
							</td>
							<td>
								{% if entry.date %}
									{{ entry.date|datetime('short') }}
								{% else %}
									<span class="light">-</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p class="light">{{ 'shipmentEdit.statusHistory.none'|t('shipments') }}</p>
		{% endif %}
	</div>

	{# Custom field tabs #}
	{% for layoutTab in customFieldTabs %}
		<div id="{{ layoutTab.getId() }}" class="hidden">
			{{ layoutTab.getContent()|raw }}
		</div>
	{% endfor %}
	{% include 'shipments/_includes/plugin-footer' %}
{% endblock %}
