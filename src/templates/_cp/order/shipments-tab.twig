{#
	Rendered via the `cp.commerce.order.content` hook. The wrapping
	`<div id="orderShipmentsTab" class="hidden">` is required: Commerce's tab JS toggles
	`hidden` on the element matching the tab URL hash. Same pattern as
	`commerce/orders/_history.twig` and `_transactions.twig`.

	@var order \craft\commerce\elements\Order
	@var shipments \fostercommerce\shipments\elements\Shipment[]    non-trashed shipments only
	@var trashedShipmentsCount int                                       count of trashed shipments for this order; surfaced as a Restore button
	@var unallocatedPool array<int, int>                                 lineItemId to remaining qty
	@var suggestedGroups list<array<int, int>>                           pre-filled staging groups (lineItemId to qty)
	@var trackedState string                                             'active' or 'ignored' for the current "Order requires shipping" state
	@var trackedShippable string                                         'yes' / 'no' / 'unknown' cached shippability verdict
	@var isOrderStatusIgnored bool                                       true when order's current status is in the plugin's ignore list
	@var isTracked bool                                                  true when the order has a row in shipments_tracked_orders (versus never-touched)
#}

{% import "_includes/forms" as forms %}

{% set unallocated = [] %}
{% for lineItem in order.getLineItems() %}
	{% set remaining = unallocatedPool[lineItem.id] ?? 0 %}
	{% if remaining > 0 %}
		{% set unallocated = unallocated|merge([{ lineItem: lineItem, remainingQty: remaining }]) %}
	{% endif %}
{% endfor %}

{# Fallback to a single group that claims everything when the rules engine produced nothing. #}
{% set stagingGroups = suggestedGroups|default([])|length ? suggestedGroups : [{}] %}
{% set groupLetters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'] %}

{% set switchIsOn = trackedState == 'active' %}
{% set switchIsLocked = isOrderStatusIgnored %}
{% set isUnderAllocated = order.isCompleted and unallocated|length > 0 %}
{% set showNoShippableNotice = trackedShippable == 'no' and not isOrderStatusIgnored %}
{% set showSwitchOffNotice = isTracked and not isOrderStatusIgnored %}

<div id="orderShipmentsTab" class="hidden">

	{# Order requires shipping lightswitch #}
	{#
		Uses Craft's native `forms.lightswitchField` `toggle` / `reverseToggle` to flip the
		dependent panes' `hidden` class as the user interacts with the switch. No nested form
		(Commerce's order edit page is already wrapped in `<form id="main-form">`, and HTML5
		drops nested `<form>` tags). Persistence happens over AJAX in ShipmentsCpAsset:
		`Craft.sendActionRequest` to set-active / set-ignored.
	#}
	<div class="pane shipments-requires-shipping-pane"
		data-shipments-requires-shipping
		data-order-id="{{ order.id }}"
		data-switch-on="{{ switchIsOn ? '1' : '0' }}"
	>
		{{ forms.lightswitchField({
			label: 'orderTab.requiresShippingLabel'|t('shipments'),
			instructions: switchIsLocked
				? 'orderTab.statusIgnoredSwitchLocked'|t('shipments')
				: (switchIsOn
					? 'orderTab.requiresShippingOffHelp'|t('shipments')
					: 'orderTab.requiresShippingOnHelp'|t('shipments')),
			id: 'shipments-requires-shipping-lightswitch',
			name: 'requiresShipping',
			on: switchIsOn,
			disabled: switchIsLocked,
			onLabel: 'common.yes'|t('shipments'),
			offLabel: 'common.no'|t('shipments'),
			toggle: '.shipments-show-when-on',
			reverseToggle: '.shipments-show-when-off',
		}) }}
	</div>

	{% if showNoShippableNotice %}
		<div class="pane shipments-no-shippable-notice shipments-show-when-on{% if not switchIsOn %} hidden{% endif %}">
			<p>{{ 'error.noShippableLineItems'|t('shipments') }}</p>
		</div>
	{% endif %}


	{# Under-allocation notice #}
	{# Server truth only: reflects what's actually saved. Staging-form activity doesn't
	   affect this; it only clears on reload after a successful save. #}
	{% if isUnderAllocated %}
		<div class="pane shipments-under-allocation-notice shipments-show-when-on{% if not switchIsOn %} hidden{% endif %}">
			<h2>
				<span class="shipments-under-allocation-icon" data-icon="alert" aria-hidden="true"></span>
				{{ 'orderTab.notFullyAllocated'|t('shipments') }}
			</h2>
			<p>{{ 'orderTab.unallocatedQuantityNotice'|t('shipments') }}</p>
			<ul>
				{% for row in unallocated %}
					<li>
						<strong>{{ row.lineItem.description ?? row.lineItem.snapshot.title ?? row.lineItem.sku ?? row.lineItem.id }}</strong>:
						{{ row.remainingQty }} {{ 'orderTab.unallocated'|t('shipments') }}
						{% if row.lineItem.sku %}
							<code class="light">{{ row.lineItem.sku }}</code>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		</div>
	{% endif %}

	{# Restore trashed shipments #}
	{% if trashedShipmentsCount > 0 and switchIsOn %}
		<div class="pane shipments-restore-pane shipments-show-when-on{% if not switchIsOn %} hidden{% endif %}" data-shipments-restore-pane data-order-id="{{ order.id }}">
			<p>{{ 'orderTab.trashedShipmentsNotice'|t('shipments', { count: trashedShipmentsCount }) }}</p>
			<div class="buttons">
				<button type="button" class="btn" id="shipments-restore-button">{{ 'orderTab.restoreShipments'|t('shipments', { count: trashedShipmentsCount }) }}</button>
			</div>
		</div>
	{% endif %}

	{# Existing shipments #}
	{% if shipments|length %}
		<h2>{{ 'nav.shipments'|t('shipments') }} ({{ shipments|length }})</h2>

		{% for shipment in shipments %}
			{% set statusEnum = shipment.statusEnum %}
			<div class="pane shipments-card">
				<div class="shipments-card-header">
					<h3>
						<code>{{ shipment.reference }}</code>
						<span class="status-label {{ statusEnum.color() }}"><span class="status {{ statusEnum.color() }}"></span><span class="status-label-text">{{ statusEnum.label() }}</span></span>
					</h3>
					<div>
						<a href="{{ shipment.cpEditUrl }}" class="btn">{{ 'shipmentEdit.manageShipment'|t('shipments') }}</a>
						<button type="button" class="btn shipments-remove-shipment" data-shipment-id="{{ shipment.id }}" data-reference="{{ shipment.reference }}">{{ 'common.delete'|t('shipments') }}</button>
					</div>
				</div>

				{% if shipment.lineItems|length %}
					<table class="data fullwidth shipments-card-line-items">
						<thead>
							<tr>
								<th>{{ 'shipmentEdit.lineItems.lineItem'|t('shipments') }}</th>
								<th class="thin">{{ 'shipmentEdit.lineItems.qty'|t('shipments') }}</th>
							</tr>
						</thead>
						<tbody>
							{% for shipmentLineItem in shipment.lineItems %}
								{% set matchedLineItem = null %}
								{% for orderLineItem in order.getLineItems() %}
									{% if orderLineItem.id == shipmentLineItem.lineItemId %}{% set matchedLineItem = orderLineItem %}{% endif %}
								{% endfor %}
								{% set lineItemStatus = matchedLineItem ? matchedLineItem.lineItemStatus : null %}
								<tr>
									<td>
										{% if matchedLineItem %}
											<strong>{{ matchedLineItem.description ?? matchedLineItem.snapshot.title ?? matchedLineItem.sku ?? matchedLineItem.id }}</strong>
											{% if matchedLineItem.sku and matchedLineItem.description %}
												<br><code class="light">{{ matchedLineItem.sku }}</code>
											{% endif %}
											{% if lineItemStatus %}
												<div class="shipments-line-item-status">{{ lineItemStatus.labelHtml|raw }}</div>
											{% endif %}
										{% else %}
											<code>{{ 'shipmentEdit.lineItems.lineItemNumber'|t('shipments', { id: shipmentLineItem.lineItemId }) }}</code>
										{% endif %}
									</td>
									<td><strong>{{ shipmentLineItem.qty }}</strong></td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				{% else %}
					<p class="light shipments-card-meta">{{ 'shipmentEdit.lineItems.none'|t('shipments') }}</p>
				{% endif %}

				{% if shipment.trackingNumber %}
					<p class="light shipments-card-meta">
						{{ 'shipmentEdit.tracking.heading'|t('shipments') }}:
						{% if shipment.trackingUrl %}
							<a href="{{ shipment.trackingUrl }}" target="_blank" rel="noreferrer">{{ shipment.trackingNumber }}</a>
						{% else %}
							<code>{{ shipment.trackingNumber }}</code>
						{% endif %}
					</p>
				{% endif %}

				{% if shipment.integrationReferences|length %}
					<p class="light shipments-card-meta">
						{% for reference in shipment.integrationReferences %}
							{% set referenceSource = reference.getSource() %}
							{% set referenceUrl = reference.getResolvedUrl() %}
							<span class="shipments-reference-pill">
								{{ referenceSource ? referenceSource.name : ('settings.integrations.integrationNumber'|t('shipments', { id: reference.integrationId })) }}:
								{% if referenceUrl %}
									<a href="{{ referenceUrl }}" target="_blank" rel="noreferrer"><code>{{ reference.externalId }}</code></a>
								{% else %}
									<code>{{ reference.externalId }}</code>
								{% endif %}
							</span>
						{% endfor %}
					</p>
				{% endif %}
			</div>
		{% endfor %}
	{% endif %}

	{# Switch off message #}
	{# Only shown when an admin explicitly turned the switch off. Default-untracked orders and
	   ignored-status orders are already explained by the switch label and instructions. #}
	{% if showSwitchOffNotice %}
		{% if shipments|length %}
			<hr>
		{% endif %}
		<div class="pane shipments-switch-off-notice shipments-show-when-off{% if switchIsOn %} hidden{% endif %}">
			<p>{{ 'orderTab.markedNotNeedingShipping'|t('shipments') }}</p>
		</div>
	{% endif %}

	{# Create a shipment #}
	{% if unallocated|length and not order.isCompleted %}
		{% if shipments|length %}
			<hr>
		{% endif %}
		<div class="pane shipments-order-incomplete-notice shipments-show-when-on{% if not switchIsOn %} hidden{% endif %}">
			<p>{{ 'error.shipmentsCompletedOnlyOnce'|t('shipments') }}</p>
		</div>
	{% elseif unallocated|length %}
		{% if shipments|length %}
			<hr>
		{% endif %}

		{# No `<form>`: HTML5 strips nested forms inside Commerce's `<form id="main-form">`,
		   leaving the contents loose in the DOM. The save button posts via `Craft.sendActionRequest`. #}
		<div id="shipments-create-form" class="shipments-create-form shipments-show-when-on{% if not switchIsOn %} hidden{% endif %}" data-order-id="{{ order.id }}">
			<h2>
				{{ 'orderTab.createShipments'|t('shipments') }}
				<span class="shipments-pending-pill">{{ 'orderTab.staging.pendingNotSaved'|t('shipments') }}</span>
			</h2>
			<div class="shipments-pending-notice">
				<p>
					{% if suggestedGroups|default([])|length %}
						{{ 'orderTab.staging.autoStagedNotice'|t('shipments') }}
					{% else %}
						{{ 'orderTab.staging.introNothingSaved'|t('shipments') }}
					{% endif %}
				</p>
			</div>

			<div id="shipments-staging-groups">
				{% for stagingGroup in stagingGroups %}
					{% set groupIndex = loop.index0 %}
					{% set groupLetter = groupLetters[groupIndex] ?? (groupIndex + 1) %}
					{% set groupLabel = 'orderTab.staging.shipmentLetter'|t('shipments', { letter: groupLetter }) %}
					<div class="pane shipments-staging-group" data-group-index="{{ groupIndex }}">
						<div class="shipments-staging-group-header">
							<h3 class="shipments-staging-group-label">{{ groupLabel }}</h3>
							<button type="button" class="btn shipments-remove-group{% if stagingGroups|length < 2 %} hidden{% endif %}">{{ 'orderTab.staging.removeGroup'|t('shipments') }}</button>
						</div>

						<table class="data fullwidth">
							<thead>
								<tr>
									<th>{{ 'shipmentEdit.lineItems.lineItem'|t('shipments') }}</th>
									<th class="thin">{{ 'orderTab.staging.remaining'|t('shipments') }}</th>
									<th class="thin">{{ 'orderTab.staging.qtyInGroup'|t('shipments') }}</th>
								</tr>
							</thead>
							<tbody>
								{% for row in unallocated %}
									{% set rowLineItemStatus = row.lineItem.lineItemStatus %}
									{% set suggestedQty = stagingGroup[row.lineItem.id] ?? (stagingGroups|length == 1 ? row.remainingQty : 0) %}
									<tr data-line-item-id="{{ row.lineItem.id }}" data-remaining-qty="{{ row.remainingQty }}">
										<td>
											<strong>{{ row.lineItem.description ?? row.lineItem.snapshot.title ?? row.lineItem.sku ?? row.lineItem.id }}</strong>
											{% if row.lineItem.sku and row.lineItem.description %}
												<br><code class="light">{{ row.lineItem.sku }}</code>
											{% endif %}
											{% if rowLineItemStatus %}
												<div class="shipments-line-item-status">{{ rowLineItemStatus.labelHtml|raw }}</div>
											{% endif %}
										</td>
										<td class="shipments-staging-remaining" data-line-item-id="{{ row.lineItem.id }}">0</td>
										<td>
											<input type="number" class="text shipments-staging-qty" min="0" max="{{ row.remainingQty }}" step="1"
												name="groups[{{ groupIndex }}][{{ row.lineItem.id }}]" value="{{ suggestedQty }}"
												data-line-item-id="{{ row.lineItem.id }}">
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endfor %}
			</div>

			<div class="shipments-buttons-row">
				<button type="button" class="btn add icon" id="shipments-add-group">{{ 'settings.grouping.addGroup'|t('shipments') }}</button>
			</div>

			<div id="shipments-staging-status" class="shipments-staging-status is-invalid">
				<span class="shipments-staging-status-invalid">{{ 'orderTab.staging.totalsMismatch'|t('shipments') }}</span>
				<span class="shipments-staging-status-valid">{{ 'orderTab.staging.totalsMatch'|t('shipments') }}</span>
			</div>

			<div class="buttons shipments-buttons-row">
				<button type="button" class="btn submit" id="shipments-save-button" disabled>{{ 'orderTab.staging.saveShipments'|t('shipments') }}</button>
				<span class="shipments-pending-footer light">{{ 'orderTab.staging.pendingNotSaved'|t('shipments') }}</span>
			</div>
		</div>
	{% endif %}
</div>
