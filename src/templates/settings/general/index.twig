{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set selectedItem = 'general' %}
{% set title = 'settings.nav.general'|t('shipments') %}
{% set docTitle = title %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% block content %}
	<form action="" method="post" accept-charset="UTF-8" data-saveshortcut>
		{{ actionInput('shipments/settings/save-settings') }}
		{{ redirectInput('shipments/settings/general') }}
		{{ csrfInput() }}

		<div>
			<p>
				{{ 'settings.general.intro'|t('shipments') }}
			</p>
		</div>

		<hr>

		<h2>{{ 'settings.general.autoCreationHeading'|t('shipments') }}</h2>
		<p>{{ 'settings.general.autoCreationHelp'|t('shipments') }}</p>

		{{ forms.lightswitchField({
			label: 'settings.general.autoCreationToggle'|t('shipments'),
			instructions: 'settings.general.autoCreationToggleHelp'|t('shipments'),
			id: 'shipments_auto_create_on_complete',
			name: 'settings[autoCreateOnComplete]',
			on: settings.autoCreateOnComplete,
			errors: settings.getErrors('autoCreateOnComplete'),
			toggle: '.shipments-auto-create-config',
		}) }}

		<div class="shipments-auto-create-config{% if not settings.autoCreateOnComplete %} hidden{% endif %}">
			<h3>{{ 'settings.general.groupingHeading'|t('shipments') }}</h3>
			<p>
				{{ 'settings.general.groupingHelp'|t('shipments') }}
			</p>
			<p>
				{{ 'settings.general.singleGroupDefaultHelp'|t('shipments') }}
			</p>

			{% set groupingSourceOptions = [{ label: 'settings.general.singleGroupOption'|t('shipments'), value: 'none' }] %}
			{% for rule in availableRules %}
				{% set groupingSourceOptions = groupingSourceOptions|merge([{ label: rule.name, value: rule.handle }]) %}
			{% endfor %}

			{{ forms.selectField({
				label: 'settings.general.groupingSourceLabel'|t('shipments'),
				instructions: 'settings.general.groupingSourceHelp'|t('shipments'),
				id: 'shipments_grouping_source',
				name: 'settings[groupingSource]',
				value: settings.groupingSource,
				options: groupingSourceOptions,
				errors: settings.getErrors('groupingSource'),
				toggle: true,
				targetPrefix: '.shipments-source-',
			}) }}

			<div class="shipments-source-inventory-status{% if settings.groupingSource != 'inventory-status' %} hidden{% endif %}">
				<p class="light">
					{{ 'settings.grouping.inventoryStateExplanation'|t('shipments')|md }}
				</p>

				{{ forms.selectField({
					label: 'settings.grouping.inStockBucketLabel'|t('shipments'),
					instructions: 'settings.grouping.inStockBucketHelp'|t('shipments'),
					id: 'shipments_inventory_in_stock',
					name: 'settings[inventoryGroupingModes][inStock]',
					value: settings.inventoryGroupingModes.inStock ?? 'together',
					options: [
						{ label: 'settings.grouping.modeTogether'|t('shipments'), value: 'together' },
						{ label: 'settings.grouping.modePerLineItem'|t('shipments'), value: 'per-item' },
					],
				}) }}

				{{ forms.selectField({
					label: 'settings.grouping.backorderedBucketLabel'|t('shipments'),
					instructions: 'settings.grouping.backorderedBucketHelp'|t('shipments'),
					id: 'shipments_inventory_backorder',
					name: 'settings[inventoryGroupingModes][backorder]',
					value: settings.inventoryGroupingModes.backorder ?? 'together',
					options: [
						{ label: 'settings.grouping.modeTogether'|t('shipments'), value: 'together' },
						{ label: 'settings.grouping.modePerLineItem'|t('shipments'), value: 'per-item' },
					],
				}) }}

				{{ forms.selectField({
					label: 'settings.grouping.quantitySplitModeLabel'|t('shipments'),
					instructions: 'settings.grouping.quantitySplitHelp'|t('shipments'),
					id: 'shipments_qty_split_mode',
					name: 'settings[qtySplitMode]',
					value: settings.qtySplitMode,
					errors: settings.getErrors('qtySplitMode'),
					options: [
						{ label: 'settings.grouping.quantitySplitSplit'|t('shipments'), value: 'split' },
						{ label: 'settings.grouping.quantitySplitAtomic'|t('shipments'), value: 'atomic' },
					],
				}) }}
			</div>

			<div class="shipments-source-line-item-status{% if settings.groupingSource != 'line-item-status' %} hidden{% endif %}">
				<h4>{{ 'settings.grouping.groupsHeading'|t('shipments') }}</h4>
				<p>
					{{ 'settings.grouping.lineItemStatusGroupsIntro'|t('shipments') }}
				</p>

				{% if lineItemStatuses|length %}
					{% set groupSlots = settings.lineItemStatusGroups|merge([{ mode: 'together', statusHandles: [] }]) %}
					{% set groupErrors = settings.getErrors('lineItemStatusGroups') %}
					{% if groupErrors|length %}
						<ul class="errors">
							{% for error in groupErrors %}<li>{{ error }}</li>{% endfor %}
						</ul>
					{% endif %}

					{% for groupIndex, group in groupSlots %}
						{% set isBlankSlot = loop.last and (group.statusHandles ?? [])|length == 0 %}
						<div class="pane shipments-rule-group-pane{% if isBlankSlot %} shipments-new-rule-pane hidden{% endif %}">
							<h5 class="shipments-rule-group-heading">
								{% if isBlankSlot %}
									{{ 'settings.grouping.addRule'|t('shipments') }}
								{% else %}
									{{ 'settings.grouping.ruleHeading'|t('shipments', { number: loop.index }) }}
								{% endif %}
							</h5>

							{{ forms.checkboxSelectField({
								label: 'settings.grouping.lineItemStatusesInGroup'|t('shipments'),
								instructions: 'settings.grouping.lineItemStatusesInGroupHelp'|t('shipments'),
								id: 'shipments_line_item_status_group_' ~ groupIndex ~ '_handles',
								name: 'settings[lineItemStatusGroups][' ~ groupIndex ~ '][statusHandles]',
								values: group.statusHandles ?? [],
								options: lineItemStatusOptions,
							}) }}

							{{ forms.selectField({
								label: 'settings.grouping.groupingModeLabel'|t('shipments'),
								id: 'shipments_line_item_status_group_' ~ groupIndex ~ '_mode',
								name: 'settings[lineItemStatusGroups][' ~ groupIndex ~ '][mode]',
								value: group.mode ?? 'together',
								options: [
									{ label: 'settings.grouping.modeTogetherCombined'|t('shipments'), value: 'together' },
									{ label: 'settings.grouping.modePerLineItem'|t('shipments'), value: 'per-item' },
								],
							}) }}

							{% if isBlankSlot %}
								<p class="light shipments-rule-group-hint">{{ 'settings.grouping.pickStatusesHelp'|t('shipments') }}</p>
							{% endif %}
						</div>
					{% endfor %}

					<p class="shipments-add-rule-row">
						<button type="button" class="btn add icon" id="shipments-add-rule">{{ 'settings.grouping.addRule'|t('shipments') }}</button>
					</p>
				{% else %}
					<p class="light">{{ 'settings.grouping.noLineItemStatuses'|t('shipments') }}</p>
				{% endif %}
			</div>

			<div class="shipments-source-shipping-category{% if settings.groupingSource != 'shipping-category' %} hidden{% endif %}">
				<h4>{{ 'settings.grouping.groupsHeading'|t('shipments') }}</h4>
				<p>
					{{ 'settings.grouping.shippingCategoryGroupsIntro'|t('shipments') }}
				</p>

				{% if shippingCategoryOptions|length %}
					{% set categoryGroupSlots = settings.shippingCategoryGroups|merge([{ mode: 'together', categoryHandles: [] }]) %}
					{% set categoryGroupErrors = settings.getErrors('shippingCategoryGroups') %}
					{% if categoryGroupErrors|length %}
						<ul class="errors">
							{% for error in categoryGroupErrors %}<li>{{ error }}</li>{% endfor %}
						</ul>
					{% endif %}

					{% for groupIndex, group in categoryGroupSlots %}
						{% set isBlankSlot = loop.last and (group.categoryHandles ?? [])|length == 0 %}
						<div class="pane shipments-rule-group-pane{% if isBlankSlot %} shipments-new-category-rule-pane hidden{% endif %}">
							<h5 class="shipments-rule-group-heading">
								{% if isBlankSlot %}
									{{ 'settings.grouping.addRule'|t('shipments') }}
								{% else %}
									{{ 'settings.grouping.ruleHeading'|t('shipments', { number: loop.index }) }}
								{% endif %}
							</h5>

							{{ forms.checkboxSelectField({
								label: 'settings.grouping.shippingCategoriesInGroup'|t('shipments'),
								instructions: 'settings.grouping.shippingCategoriesInGroupHelp'|t('shipments'),
								id: 'shipments_shipping_category_group_' ~ groupIndex ~ '_handles',
								name: 'settings[shippingCategoryGroups][' ~ groupIndex ~ '][categoryHandles]',
								values: group.categoryHandles ?? [],
								options: shippingCategoryOptions,
							}) }}

							{{ forms.selectField({
								label: 'settings.grouping.groupingModeLabel'|t('shipments'),
								id: 'shipments_shipping_category_group_' ~ groupIndex ~ '_mode',
								name: 'settings[shippingCategoryGroups][' ~ groupIndex ~ '][mode]',
								value: group.mode ?? 'together',
								options: [
									{ label: 'settings.grouping.modeTogetherCombined'|t('shipments'), value: 'together' },
									{ label: 'settings.grouping.modePerLineItem'|t('shipments'), value: 'per-item' },
								],
							}) }}

							{% if isBlankSlot %}
								<p class="light shipments-rule-group-hint">{{ 'settings.grouping.pickCategoriesHelp'|t('shipments') }}</p>
							{% endif %}
						</div>
					{% endfor %}

					<p class="shipments-add-rule-row">
						<button type="button" class="btn add icon" id="shipments-add-category-rule">{{ 'settings.grouping.addRule'|t('shipments') }}</button>
					</p>
				{% else %}
					<p class="light">{{ 'settings.grouping.noShippingCategories'|t('shipments') }}</p>
				{% endif %}
			</div>
		</div>

		<hr>

		<h2>{{ 'settings.validation.heading'|t('shipments') }}</h2>
		<p>{{ 'settings.validation.intro'|t('shipments') }}</p>

		{{ forms.lightswitchField({
			label: 'settings.validation.enforceFullCoverage'|t('shipments'),
			instructions: 'settings.validation.enforceFullCoverageHelp'|t('shipments'),
			id: 'shipments_enforce_coverage',
			name: 'settings[enforceCoverage]',
			on: settings.enforceCoverage,
			errors: settings.getErrors('enforceCoverage'),
		}) }}

		{{ forms.checkboxSelectField({
			label: 'settings.validation.lineItemStatusesToIgnore'|t('shipments'),
			instructions: 'settings.validation.lineItemStatusesToIgnoreHelp'|t('shipments'),
			id: 'shipments_line_item_statuses_to_ignore',
			name: 'settings[lineItemStatusesToIgnore]',
			values: settings.lineItemStatusesToIgnore,
			options: lineItemStatusOptions,
			errors: settings.getErrors('lineItemStatusesToIgnore'),
		}) }}

		<hr>

		<h2>{{ 'settings.tracking.orderStatusesToIgnore'|t('shipments') }}</h2>
		<p>{{ 'settings.tracking.orderStatusesToIgnoreHelp'|t('shipments') }}</p>

		{% if orderStatusOptions|length %}
			{{ forms.checkboxSelectField({
				label: 'settings.tracking.orderStatusesToIgnore'|t('shipments'),
				id: 'shipments_order_statuses_to_ignore',
				name: 'settings[orderStatusesToIgnore]',
				values: settings.orderStatusesToIgnore,
				options: orderStatusOptions,
				errors: settings.getErrors('orderStatusesToIgnore'),
			}) }}
		{% else %}
			<p class="light">{{ 'settings.tracking.noOrderStatuses'|t('shipments') }}</p>
		{% endif %}

		<hr>

		<div class="buttons">
			<button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>
		</div>
	</form>
{% endblock %}
