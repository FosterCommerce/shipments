{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set selectedItem = 'general' %}
{% set title = 'General'|t('shipments') %}
{% set docTitle = title %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'Shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% block content %}
	<form action="" method="post" accept-charset="UTF-8" data-saveshortcut>
		{{ actionInput('shipments/settings/save-settings') }}
		{{ redirectInput('shipments/settings/general') }}
		{{ csrfInput() }}

		<div>
			<p>
				{{ 'Adds first-class shipments to Craft Commerce. Every completed order produces at least one shipment; configure the grouping source below to split an order into multiple shipments when needed. Shipments have their own statuses, emails, and API for integrating with fulfillment systems.'|t('shipments') }}
			</p>
		</div>

		<hr>

		<h2>{{ 'Automatic shipment creation'|t('shipments') }}</h2>
		<p>{{ 'How shipments get created when a customer completes an order.'|t('shipments') }}</p>

		{{ forms.lightswitchField({
			label: 'Create shipments automatically on order completion'|t('shipments'),
			instructions: 'When enabled, completing an order runs the grouping engine and creates shipments. Turn this off if your store creates shipments manually on the order edit page.'|t('shipments'),
			id: 'shipments_auto_create_on_complete',
			name: 'settings[autoCreateOnComplete]',
			on: settings.autoCreateOnComplete,
			errors: settings.getErrors('autoCreateOnComplete'),
			toggle: '.shipments-auto-create-config',
		}) }}

		<div class="shipments-auto-create-config{% if not settings.autoCreateOnComplete %} hidden{% endif %}">
			<h3>{{ 'Shipment grouping'|t('shipments') }}</h3>
			<p>
				{{ 'Pick the signal that decides when an auto-built order should split into multiple shipments. For each bucket the signal produces (each inventory state, each line item status), you then say whether those items ship together in one shipment or get one shipment per line item.'|t('shipments') }}
			</p>
			<p>
				{{ 'The default is “One shipment group per order”. Every order produces a single shipment. Change the grouping source below if your store needs finer control.'|t('shipments') }}
			</p>

			{% set groupingSourceOptions = [{ label: 'One shipment group per order'|t('shipments'), value: 'none' }] %}
			{% for rule in availableRules %}
				{% set groupingSourceOptions = groupingSourceOptions|merge([{ label: rule.name, value: rule.handle }]) %}
			{% endfor %}

			{{ forms.selectField({
				label: 'Grouping source'|t('shipments'),
				instructions: 'Where the grouping decision comes from.'|t('shipments'),
				id: 'shipments_grouping_source',
				name: 'settings[groupingSource]',
				value: settings.groupingSource,
				options: groupingSourceOptions,
				errors: settings.getErrors('groupingSource'),
				toggle: true,
				targetPrefix: '.shipments-source-',
			}) }}

			<div class="shipments-source-inventory-status{% if settings.groupingSource != 'inventory-status' %} hidden{% endif %}">
				<p class="light">
					{{ 'A purchasable is **in-stock** when Craft Commerce reports available stock for it (`Purchasable::hasStock()` is `true`); this includes purchasables that aren’t inventory-tracked. It’s **backordered** when inventory tracking is on and no stock is available. On the Commerce inventory screen this is effectively the **Available** column.'|t('shipments')|md }}
				</p>

				{{ forms.selectField({
					label: 'In-stock items'|t('shipments'),
					instructions: 'Applies to line items whose purchasable has available stock or isn’t inventory-tracked.'|t('shipments'),
					id: 'shipments_inventory_in_stock',
					name: 'settings[inventoryGroupingModes][inStock]',
					value: settings.inventoryGroupingModes.inStock ?? 'together',
					options: [
						{ label: 'Ship together (one shipment)'|t('shipments'), value: 'together' },
						{ label: 'One shipment per line item'|t('shipments'), value: 'per-item' },
					],
				}) }}

				{{ forms.selectField({
					label: 'Backordered items'|t('shipments'),
					instructions: 'Applies to line items whose purchasable is inventory-tracked and has no available stock.'|t('shipments'),
					id: 'shipments_inventory_backorder',
					name: 'settings[inventoryGroupingModes][backorder]',
					value: settings.inventoryGroupingModes.backorder ?? 'together',
					options: [
						{ label: 'Ship together (one shipment)'|t('shipments'), value: 'together' },
						{ label: 'One shipment per line item'|t('shipments'), value: 'per-item' },
					],
				}) }}

				{{ forms.selectField({
					label: 'Quantity split mode'|t('shipments'),
					instructions: 'Controls what happens to a line item whose stock partially covers the ordered quantity. “Split” lets the line item appear in both the in-stock and backorder buckets with partial qtys; “atomic” moves the whole line item into the backorder bucket if any portion is backordered.'|t('shipments'),
					id: 'shipments_qty_split_mode',
					name: 'settings[qtySplitMode]',
					value: settings.qtySplitMode,
					errors: settings.getErrors('qtySplitMode'),
					options: [
						{ label: 'Split (partial quantities allowed)'|t('shipments'), value: 'split' },
						{ label: 'Atomic (line item stays whole)'|t('shipments'), value: 'atomic' },
					],
				}) }}
			</div>

			<div class="shipments-source-line-item-status{% if settings.groupingSource != 'line-item-status' %} hidden{% endif %}">
				<h4>{{ 'Shipment groups'|t('shipments') }}</h4>
				<p>
					{{ 'Define the shipment groups your store needs. Each group becomes its own shipment (or, in per-item mode, one shipment per matched line item). Line items whose status isn’t assigned to any group fall through to the fallback shipment. A status can only belong to one group.'|t('shipments') }}
				</p>

				{% if lineItemStatuses|length %}
					{% set groupSlots = settings.lineItemStatusGroups|merge([{ mode: 'together', statusHandles: [] }]) %}
					{% set groupErrors = settings.getErrors('lineItemStatusGroups') %}
					{% if groupErrors|length %}
						<ul class="errors">
							{% for error in groupErrors %}<li>{{ error }}</li>{% endfor %}
						</ul>
					{% endif %}

					{% for groupIndex, group in groupSlots %}
						{% set isBlankSlot = loop.last and (group.statusHandles ?? [])|length == 0 %}
						<div class="pane shipments-rule-group-pane{% if isBlankSlot %} shipments-new-rule-pane hidden{% endif %}">
							<h5 class="shipments-rule-group-heading">
								{% if isBlankSlot %}
									{{ 'Add a new rule'|t('shipments') }}
								{% else %}
									{{ 'Rule {number}'|t('shipments', { number: loop.index }) }}
								{% endif %}
							</h5>

							{{ forms.checkboxSelectField({
								label: 'Line item statuses in this group'|t('shipments'),
								instructions: 'Pick the Commerce line item statuses whose items belong to this group.'|t('shipments'),
								id: 'shipments_line_item_status_group_' ~ groupIndex ~ '_handles',
								name: 'settings[lineItemStatusGroups][' ~ groupIndex ~ '][statusHandles]',
								values: group.statusHandles ?? [],
								options: lineItemStatusOptions,
							}) }}

							{{ forms.selectField({
								label: 'Grouping mode'|t('shipments'),
								id: 'shipments_line_item_status_group_' ~ groupIndex ~ '_mode',
								name: 'settings[lineItemStatusGroups][' ~ groupIndex ~ '][mode]',
								value: group.mode ?? 'together',
								options: [
									{ label: 'Ship together (one combined shipment)'|t('shipments'), value: 'together' },
									{ label: 'One shipment per line item'|t('shipments'), value: 'per-item' },
								],
							}) }}

							{% if isBlankSlot %}
								<p class="light shipments-rule-group-hint">{{ 'Pick one or more statuses and save to create a rule.'|t('shipments') }}</p>
							{% endif %}
						</div>
					{% endfor %}

					<p class="shipments-add-rule-row">
						<button type="button" class="btn add icon" id="shipments-add-rule">{{ 'Add a new rule'|t('shipments') }}</button>
					</p>
				{% else %}
					<p class="light">{{ 'No line item statuses are defined in Commerce. Configure at least one under Commerce -> Settings -> Line Item Statuses.'|t('shipments') }}</p>
				{% endif %}
			</div>

			<div class="shipments-source-shipping-category{% if settings.groupingSource != 'shipping-category' %} hidden{% endif %}">
				<h4>{{ 'Shipment groups'|t('shipments') }}</h4>
				<p>
					{{ 'Define the shipment groups your store needs, keyed by Commerce shipping category. Each group becomes its own shipment (or, in per-item mode, one shipment per matched line item). Line items whose shipping category isn’t assigned to any group fall through to the fallback shipment. A category can only belong to one group.'|t('shipments') }}
				</p>

				{% if shippingCategoryOptions|length %}
					{% set categoryGroupSlots = settings.shippingCategoryGroups|merge([{ mode: 'together', categoryHandles: [] }]) %}
					{% set categoryGroupErrors = settings.getErrors('shippingCategoryGroups') %}
					{% if categoryGroupErrors|length %}
						<ul class="errors">
							{% for error in categoryGroupErrors %}<li>{{ error }}</li>{% endfor %}
						</ul>
					{% endif %}

					{% for groupIndex, group in categoryGroupSlots %}
						{% set isBlankSlot = loop.last and (group.categoryHandles ?? [])|length == 0 %}
						<div class="pane shipments-rule-group-pane{% if isBlankSlot %} shipments-new-category-rule-pane hidden{% endif %}">
							<h5 class="shipments-rule-group-heading">
								{% if isBlankSlot %}
									{{ 'Add a new rule'|t('shipments') }}
								{% else %}
									{{ 'Rule {number}'|t('shipments', { number: loop.index }) }}
								{% endif %}
							</h5>

							{{ forms.checkboxSelectField({
								label: 'Shipping categories in this group'|t('shipments'),
								instructions: 'Pick the Commerce shipping categories whose items belong to this group.'|t('shipments'),
								id: 'shipments_shipping_category_group_' ~ groupIndex ~ '_handles',
								name: 'settings[shippingCategoryGroups][' ~ groupIndex ~ '][categoryHandles]',
								values: group.categoryHandles ?? [],
								options: shippingCategoryOptions,
							}) }}

							{{ forms.selectField({
								label: 'Grouping mode'|t('shipments'),
								id: 'shipments_shipping_category_group_' ~ groupIndex ~ '_mode',
								name: 'settings[shippingCategoryGroups][' ~ groupIndex ~ '][mode]',
								value: group.mode ?? 'together',
								options: [
									{ label: 'Ship together (one combined shipment)'|t('shipments'), value: 'together' },
									{ label: 'One shipment per line item'|t('shipments'), value: 'per-item' },
								],
							}) }}

							{% if isBlankSlot %}
								<p class="light shipments-rule-group-hint">{{ 'Pick one or more categories and save to create a rule.'|t('shipments') }}</p>
							{% endif %}
						</div>
					{% endfor %}

					<p class="shipments-add-rule-row">
						<button type="button" class="btn add icon" id="shipments-add-category-rule">{{ 'Add a new rule'|t('shipments') }}</button>
					</p>
				{% else %}
					<p class="light">{{ 'No shipping categories are defined in Commerce. Configure at least one under Commerce -> Settings -> Shipping Categories.'|t('shipments') }}</p>
				{% endif %}
			</div>
		</div>

		<hr>

		<h2>{{ 'Manual shipment validation'|t('shipments') }}</h2>
		<p>{{ 'Rules that apply whenever a shipment is saved from the control panel (and whenever shipments are rebuilt).'|t('shipments') }}</p>

		{{ forms.lightswitchField({
			label: 'Enforce full coverage'|t('shipments'),
			instructions: 'When enabled, manual shipment saves are rejected unless every non-ignored line item quantity on the order is accounted for across all shipments.'|t('shipments'),
			id: 'shipments_enforce_coverage',
			name: 'settings[enforceCoverage]',
			on: settings.enforceCoverage,
			errors: settings.getErrors('enforceCoverage'),
		}) }}

		{{ forms.checkboxSelectField({
			label: 'Line item statuses to ignore'|t('shipments'),
			instructions: 'Line items with any of these statuses (e.g. refunded, cancelled) are skipped entirely: they won’t appear in any shipment and they won’t count toward the coverage check.'|t('shipments'),
			id: 'shipments_line_item_statuses_to_ignore',
			name: 'settings[lineItemStatusesToIgnore]',
			values: settings.lineItemStatusesToIgnore,
			options: lineItemStatusOptions,
			errors: settings.getErrors('lineItemStatusesToIgnore'),
		}) }}

		<hr>

		<h2>{{ 'Order statuses to ignore'|t('shipments') }}</h2>
		<p>{{ 'Orders in these Commerce statuses are automatically marked as not requiring shipping. Any existing shipments on them will be moved to the trash, and new shipments can’t be staged as long as the order sits in one of these statuses. Adding a handle here runs a one-time sweep over orders currently in that status on save.'|t('shipments') }}</p>

		{% if orderStatusOptions|length %}
			{{ forms.checkboxSelectField({
				label: 'Order statuses to ignore'|t('shipments'),
				id: 'shipments_order_statuses_to_ignore',
				name: 'settings[orderStatusesToIgnore]',
				values: settings.orderStatusesToIgnore,
				options: orderStatusOptions,
				errors: settings.getErrors('orderStatusesToIgnore'),
			}) }}
		{% else %}
			<p class="light">{{ 'No Commerce order statuses are defined. Configure at least one under Commerce -> Settings -> Order Statuses.'|t('shipments') }}</p>
		{% endif %}

		<hr>

		<div class="buttons">
			<button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>
		</div>
	</form>
{% endblock %}
