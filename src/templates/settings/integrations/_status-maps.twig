{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{#
	Per-integration status mapping editor. One editable table per axis.

	@var integration        fostercommerce\shipments\models\Integration
	@var maps               list<array<string, mixed>>
	@var fulfillmentOptions array<string, string>
	@var shippingOptions    array<string, string>
	@var directionOptions   array<string, string>
#}

{% set selectedItem = 'integrations' %}
{% set fullPageForm = true %}

{% set crumbs = [
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/shipments') },
	{ label: 'nav.settings'|t('shipments'), url: url('shipments/settings/general') },
	{ label: 'nav.integrations'|t('shipments'), url: url('shipments/settings/integrations') },
	{ label: integration.name, url: integration.cpEditUrl },
] %}

{% set fulfillmentRows = [] %}
{% set shippingRows = [] %}
{% for row in maps %}
	{% set entry = {
		externalCode: row.externalCode,
		externalLabel: row.externalLabel,
		direction: row.direction,
		internalCode: row.internalCode,
	} %}
	{% if row.axis == 'fulfillment' %}
		{% set fulfillmentRows = fulfillmentRows|merge([entry]) %}
	{% elseif row.axis == 'shipping' %}
		{% set shippingRows = shippingRows|merge([entry]) %}
	{% endif %}
{% endfor %}

{% set commonCols = {
	externalCode: {
		heading: 'settings.integrations.externalCode'|t('shipments'),
		type: 'singleline',
		code: true,
	},
	externalLabel: {
		heading: 'settings.integrations.externalLabel'|t('shipments'),
		type: 'singleline',
	},
	direction: {
		heading: 'settings.integrations.directionLabel'|t('shipments'),
		type: 'select',
		options: directionOptions|map((label, value) => ({ label: label, value: value }))|values,
	},
} %}

{% block content %}
	{{ actionInput('shipments/integrations/status-maps') }}
	{{ redirectInput('shipments/settings/integrations/' ~ integration.id ~ '/status-maps') }}

	<p class="light">{{ 'settings.integrations.statusMapIntro'|t('shipments') }}</p>

	{{ forms.editableTableField({
		label: 'settings.integrations.fulfillmentMappingsHeading'|t('shipments'),
		id: 'fulfillmentMaps',
		name: 'fulfillmentMaps',
		cols: commonCols|merge({
			internalCode: {
				heading: 'settings.integrations.mapsToFulfillment'|t('shipments'),
				type: 'select',
				options: fulfillmentOptions|map((label, value) => ({ label: label, value: value }))|values,
			},
		}),
		rows: fulfillmentRows,
		addRowLabel: 'settings.integrations.addFulfillmentMapping'|t('shipments'),
	}) }}

	{{ forms.editableTableField({
		label: 'settings.integrations.shippingMappingsHeading'|t('shipments'),
		id: 'shippingMaps',
		name: 'shippingMaps',
		cols: commonCols|merge({
			internalCode: {
				heading: 'settings.integrations.mapsToShipping'|t('shipments'),
				type: 'select',
				options: shippingOptions|map((label, value) => ({ label: label, value: value }))|values,
			},
		}),
		rows: shippingRows,
		addRowLabel: 'settings.integrations.addShippingMapping'|t('shipments'),
	}) }}
{% endblock %}
