{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{#
	Per-integration status mapping editor.

	@var integration      fostercommerce\shipments\models\Integration
	@var maps             list<array<string, mixed>>
	@var statusOptions    array<string, string>
	@var directionOptions array<string, string>
#}

{% set selectedItem = 'integrations' %}
{% set fullPageForm = true %}

{% set crumbs = [
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/shipments') },
	{ label: 'nav.settings'|t('shipments'), url: url('shipments/settings/general') },
	{ label: 'nav.integrations'|t('shipments'), url: url('shipments/settings/integrations') },
	{ label: integration.name, url: integration.cpEditUrl },
] %}

{% set statusRows = [] %}
{% for row in maps %}
	{% set statusRows = statusRows|merge([{
		externalCode: row.externalCode,
		externalLabel: row.externalLabel,
		direction: row.direction,
		internalCode: row.internalCode,
	}]) %}
{% endfor %}

{% set commonCols = {
	externalCode: {
		heading: 'settings.integrations.externalCode'|t('shipments'),
		type: 'singleline',
		code: true,
	},
	externalLabel: {
		heading: 'settings.integrations.externalLabel'|t('shipments'),
		type: 'singleline',
	},
	direction: {
		heading: 'settings.integrations.directionLabel'|t('shipments'),
		type: 'select',
		options: directionOptions|map((label, value) => ({ label: label, value: value }))|values,
	},
} %}

{% block content %}
	{{ actionInput('shipments/integrations/status-maps') }}
	{{ redirectInput('shipments/settings/integrations/' ~ integration.id ~ '/status-maps') }}

	<p class="light">{{ 'settings.integrations.statusMapIntro'|t('shipments') }}</p>

	{{ forms.editableTableField({
		label: 'settings.integrations.statusMappingsHeading'|t('shipments'),
		id: 'statusMaps',
		name: 'statusMaps',
		cols: commonCols|merge({
			internalCode: {
				heading: 'settings.integrations.mapsToStatus'|t('shipments'),
				type: 'select',
				options: statusOptions|map((label, value) => ({ label: label, value: value }))|values,
			},
		}),
		rows: statusRows,
		addRowLabel: 'settings.integrations.addStatusMapping'|t('shipments'),
	}) }}
{% endblock %}
