{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{#
	Integration edit page. Sidebar carries the Provider selector + Enabled switch; those
	drive what appears in the main tabs. Main content is split into:
	 - "Integration" tab: name, handle, URL template (domain-agnostic fields the row always has).
	 - "Provider" tab: the selected provider's own settings form; the template renders every
	   provider's panel up front and JS toggles visibility based on the Provider select.

 	@var integration \fostercommerce\shipments\models\Integration
	@var gatewayEndpointUrl string|null
	@var providerOptions list of provider option rows; each row has label (string) and value (string)
	@var providerSettings map keyed by provider class name, value is the rendered settings HTML (string)
#}

{% set selectedItem = 'integrations' %}
{% set fullPageForm = true %}
{% set selectedTab = 'integration' %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
	{ label: 'nav.integrations'|t('shipments'), url: url('shipments/settings/integrations') },
] %}

{% set tabs = {
	integration: { label: 'settings.integrations.integration'|t('shipments'), url: '#integration' },
	'provider-settings': { label: 'settings.integrations.provider'|t('shipments'), url: '#provider-settings' },
} %}

{% block content %}
	{{ actionInput('shipments/integrations/save') }}
	{{ redirectInput('shipments/settings/integrations') }}
	{% if integration.id %}<input type="hidden" name="id" value="{{ integration.id }}">{% endif %}

	{# Integration tab #}
	<div id="integration">
		{{ forms.textField({
			label: 'shipmentEdit.name'|t('shipments'),
			instructions: 'settings.integrations.nameHelp'|t('shipments'),
			required: true,
			id: 'name',
			name: 'name',
			value: integration.name,
			errors: integration.getErrors('name'),
			autofocus: true,
		}) }}

		{{ forms.textField({
			label: 'settings.integrations.handle'|t('shipments'),
			instructions: 'settings.integrations.handleHelp'|t('shipments'),
			required: true,
			id: 'handle',
			name: 'handle',
			class: 'code',
			value: integration.handle,
			errors: integration.getErrors('handle'),
		}) }}

		{{ forms.textField({
			label: 'settings.integrations.urlTemplate'|t('shipments'),
			instructions: 'settings.integrations.urlTemplateHelp'|t('shipments'),
			id: 'urlTemplate',
			name: 'urlTemplate',
			class: 'ltr',
			value: integration.urlTemplate,
			errors: integration.getErrors('urlTemplate'),
		}) }}
	</div>

	{# Provider tab. Rendered only when at least one provider is registered. JS hides the
	   tab link when the sidebar Provider select is blank and shows it again when one is picked.
	   Pane id is `provider-settings` (not `provider`) to avoid colliding with the sidebar
	   Provider select's id. #}
	<div id="provider-settings" class="hidden">
		{% if providerOptions|length %}
			{% for option in providerOptions %}
				<div class="shipments-provider-panel{% if integration.provider != option.value %} hidden{% endif %}" data-provider="{{ option.value }}">
					{{ providerSettings[option.value]|raw }}
				</div>
			{% endfor %}
		{% endif %}
	</div>
{% endblock %}

{# Sidebar: Provider + Enabled #}
{% block details %}
	<div class="meta">
		{% set providerSelectOptions = [{ label: 'settings.integrations.providerNone'|t('shipments'), value: '' }]|merge(providerOptions) %}
		{{ forms.selectField({
			label: 'settings.integrations.provider'|t('shipments'),
			required: providerOptions|length > 0,
			id: 'provider',
			name: 'provider',
			value: integration.provider,
			options: providerSelectOptions,
			errors: integration.getErrors('provider'),
		}) }}

		{{ forms.lightswitchField({
			label: 'shipmentEdit.enabled'|t('shipments'),
			id: 'enabled',
			name: 'enabled',
			on: integration.enabled,
		}) }}
	</div>

	{% if integration.provider %}
		<fieldset>
			<legend class="h6">Gateway</legend>
			<div class="meta">
				<div class="field">
					<div class="ltr shipments-gateway-url">
						{% if gatewayEndpointUrl %}
							<code id="shipments-gateway-url">{{ gatewayEndpointUrl }}</code>
							<button type="button" class="btn small" id="shipments-copy-gateway-url" data-url="{{ gatewayEndpointUrl|e('html_attr') }}">
								<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 16 16" style="vertical-align: -2px; margin-right: 4px;">
									<path fill="currentColor" d="M4 2.5A1.5 1.5 0 0 1 5.5 1h7A1.5 1.5 0 0 1 14 2.5v7a1.5 1.5 0 0 1-1.5 1.5H11v1.5A1.5 1.5 0 0 1 9.5 14h-6A1.5 1.5 0 0 1 2 12.5v-6A1.5 1.5 0 0 1 3.5 5H4V2.5ZM5.5 2a.5.5 0 0 0-.5.5V5h4.5A1.5 1.5 0 0 1 11 6.5V10h1.5a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5h-7ZM3.5 6a.5.5 0 0 0-.5.5v6a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5v-6a.5.5 0 0 0-.5-.5h-6Z" />
								</svg>
								<span>Copy</span>
							</button>
						{% else %}
							<p class="warning">Save the integration with a handle before copying the gateway URL.</p>
						{% endif %}
					</div>
				</div>
			</div>
		</fieldset>
	{% endif %}
{% endblock %}

{% if not integration.handle %}
	{% js %}new Craft.HandleGenerator('#name', '#handle');{% endjs %}
{% endif %}

{% js %}
	document.getElementById('shipments-copy-gateway-url')?.addEventListener('click', async function() {
		try {
			await navigator.clipboard.writeText(this.dataset.url || '');
			const label = this.querySelector('span');
			const originalText = label.textContent;
			label.textContent = 'Copied';
			setTimeout(() => {
				label.textContent = originalText;
			}, 1200);
		} catch (error) {
			Craft.cp.displayError('Could not copy gateway URL.');
		}
	});
{% endjs %}
