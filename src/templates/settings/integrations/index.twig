{% extends "shipments/_layouts/settings" %}

{% set selectedItem = 'integrations' %}
{% set title = 'nav.integrations'|t('shipments') %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% block actionButton %}
	<a href="{{ url('shipments/settings/integrations/new') }}" class="btn submit add icon">{{ 'integrations.new'|t('shipments') }}</a>
{% endblock %}

{% block content %}
	{% if integrations|length %}
		<table class="data fullwidth collapsible">
			<thead>
				<tr>
					<th>{{ 'shipmentEdit.name'|t('shipments') }}</th>
					<th>{{ 'settings.integrations.handle'|t('shipments') }}</th>
					<th>{{ 'settings.integrations.urlTemplate'|t('shipments') }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for integration in integrations %}
					<tr data-id="{{ integration.id }}">
						<td>{{ integration.name }}</td>
						<td><code>{{ integration.handle }}</code></td>
						<td>
							{% if integration.urlTemplate %}<code class="light">{{ integration.urlTemplate }}</code>{% endif %}
						</td>
						<td class="thin">
							<a href="{{ integration.cpEditUrl }}" class="go" title="{{ 'common.edit'|t('shipments') }}"></a>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>{{ 'integrations.emptyState.none'|t('shipments') }} <a href="{{ url('shipments/settings/integrations/new') }}">{{ 'emails.emptyState.createOne'|t('shipments') }}</a>.</p>
	{% endif %}
{% endblock %}
