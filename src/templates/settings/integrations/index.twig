{% extends "shipments/_layouts/settings" %}

{% set selectedItem = 'integrations' %}
{% set title = 'nav.integrations'|t('shipments') %}
{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block actionButton %}
	{% if not readOnly %}
		<a href="{{ url('shipments/settings/integrations/new') }}" class="btn submit add icon">{{ 'integrations.new'|t('shipments') }}</a>
	{% endif %}
{% endblock %}

{% block content %}
	<div id="shipments-integrations-admin-table"></div>
	{% include 'shipments/_includes/plugin-footer' %}
{% endblock %}

{% js %}
	const shipmentsStatusCallback = function(value) {
		const statusClass = value.status ? 'enabled' : 'disabled';

		return '<span class="status ' + statusClass + '"></span> ' + Craft.escapeHtml(value.label);
	};

	new Craft.VueAdminTable({
		columns: [
			{ name: '__slot:title', title: {{ 'shipmentEdit.name'|t('shipments')|json_encode|raw }} },
			{ name: 'type', title: {{ 'settings.integrations.type'|t('shipments')|json_encode|raw }} },
			{ name: 'enabled', title: {{ 'settings.integrations.enabled'|t('shipments')|json_encode|raw }}, callback: shipmentsStatusCallback },
		],
		container: '#shipments-integrations-admin-table',
		{% if not readOnly %}
			deleteAction: 'shipments/integrations/delete',
			deleteConfirmationMessage: {{ 'settings.integrations.deleteConfirm'|t('shipments')|json_encode|raw }},
			deleteFailMessage: {{ 'error.integrationNotDeleted'|t('shipments')|json_encode|raw }},
			deleteSuccessMessage: {{ 'settings.integrations.deleted'|t('shipments')|json_encode|raw }},
		{% endif %}
		emptyMessage: {{ 'integrations.emptyState.none'|t('shipments')|json_encode|raw }},
		tableData: {{ integrationTableData|json_encode|raw }},
	});
{% endjs %}
