{% extends "shipments/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set selectedItem = 'emails' %}
{% set fullPageForm = true %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
	{ label: 'nav.emails'|t('shipments'), url: url('shipments/settings/emails') },
] %}

{% block content %}
	{{ actionInput('shipments/emails/save') }}
	{{ redirectInput('shipments/settings/emails') }}
	{% if email.id %}<input type="hidden" name="id" value="{{ email.id }}">{% endif %}

	{{ forms.textField({
		label: 'shipmentEdit.name'|t('shipments'),
		required: true,
		id: 'name',
		name: 'name',
		value: email.name,
		errors: email.getErrors('name'),
	}) }}

	{{ forms.textField({
		label: 'emails.subject'|t('shipments'),
		required: true,
		id: 'subject',
		name: 'subject',
		instructions: 'emails.twigContextHelp'|t('shipments'),
		value: email.subject,
		errors: email.getErrors('subject'),
	}) }}

	{{ forms.selectField({
		label: 'emails.recipientTypeLabel'|t('shipments'),
		id: 'recipientType',
		name: 'recipientType',
		value: email.recipientType,
		options: recipientTypes|map((displayName, handle) => ({ label: displayName, value: handle }))|values,
	}) }}

	{{ forms.autosuggestField({
		label: 'emails.field.to'|t('shipments'),
		instructions: 'emails.customRecipientHelp'|t('shipments'),
		id: 'to',
		name: 'to',
		value: email.getTo(false),
		suggestEnvVars: true,
		errors: email.getErrors('to'),
	}) }}

	{{ forms.autosuggestField({
		label: 'emails.field.bcc'|t('shipments'),
		id: 'bcc',
		name: 'bcc',
		value: email.getBcc(false),
		suggestEnvVars: true,
	}) }}

	{{ forms.autosuggestField({
		label: 'emails.field.cc'|t('shipments'),
		id: 'cc',
		name: 'cc',
		value: email.getCc(false),
		suggestEnvVars: true,
	}) }}

	{{ forms.textField({
		label: 'emails.field.replyTo'|t('shipments'),
		id: 'replyTo',
		name: 'replyTo',
		value: email.replyTo,
	}) }}

	{{ forms.lightswitchField({
		label: 'shipmentEdit.enabled'|t('shipments'),
		id: 'enabled',
		name: 'enabled',
		on: email.enabled,
	}) }}

	{{ forms.autosuggestField({
		label: 'emails.field.htmlTemplatePath'|t('shipments'),
		required: true,
		id: 'templatePath',
		name: 'templatePath',
		class: 'code',
		value: email.templatePath,
		errors: email.getErrors('templatePath'),
		suggestions: craft.cp.getTemplateSuggestions(),
	}) }}

	{{ forms.autosuggestField({
		label: 'emails.field.plainTextTemplatePath'|t('shipments'),
		id: 'plainTextTemplatePath',
		name: 'plainTextTemplatePath',
		class: 'code',
		value: email.plainTextTemplatePath,
		suggestions: craft.cp.getTemplateSuggestions(),
	}) }}

	{{ forms.textField({
		label: 'emails.field.language'|t('shipments'),
		required: true,
		id: 'language',
		name: 'language',
		instructions: 'emails.languageHelp'|t('shipments'),
		value: email.language,
		errors: email.getErrors('language'),
	}) }}

	<hr>

	<h2>{{ 'emails.transitionTriggers'|t('shipments') }}</h2>
	<p class="light">{{ 'emails.triggersHelp'|t('shipments') }}</p>

	{% if email.id %}
		{% set statusFieldOptions = [] %}
		{% for code, label in statusOptions %}
			{% set statusFieldOptions = statusFieldOptions|merge([{ label: label, value: code }]) %}
		{% endfor %}

		{{ forms.checkboxGroupField({
			label: 'emails.statusTriggers'|t('shipments'),
			name: 'statusBindings',
			values: statusBindings,
			options: statusFieldOptions,
		}) }}
	{% else %}
		<p class="light"><em>{{ 'emails.saveFirstForTriggers'|t('shipments') }}</em></p>
	{% endif %}
	{% include 'shipments/_includes/plugin-footer' %}
{% endblock %}
