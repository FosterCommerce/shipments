{% extends "shipments/_layouts/settings" %}

{% set selectedItem = 'emails' %}
{% set title = 'nav.shipmentEmails'|t('shipments') %}
{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.shipments'|t('shipments'), url: url('shipments/settings/general') },
] %}

{% block actionButton %}
	<a href="{{ url('shipments/settings/emails/new') }}" class="btn submit add icon">{{ 'emails.new'|t('shipments') }}</a>
{% endblock %}

{% block content %}
	{% if emails|length %}
		<table class="data fullwidth collapsible">
			<thead>
				<tr>
					<th>{{ 'shipmentEdit.name'|t('shipments') }}</th>
					<th>{{ 'emails.subject'|t('shipments') }}</th>
					<th>{{ 'emails.recipient'|t('shipments') }}</th>
					<th>{{ 'shipmentEdit.enabled'|t('shipments') }}</th>
				</tr>
			</thead>
			<tbody>
				{% for email in emails %}
					<tr data-id="{{ email.id }}">
						<td><a href="{{ email.cpEditUrl }}">{{ email.name }}</a></td>
						<td>{{ email.subject }}</td>
						<td>{{ (email.recipientType == 'customer' ? 'emails.recipientType.customer' : 'emails.recipientType.custom')|t('shipments') }}</td>
						<td>
							{% if email.enabled %}
								<span data-icon="check" title="{{ 'shipmentEdit.enabled'|t('shipments') }}"></span>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>{{ 'emails.emptyState.none'|t('shipments') }} <a href="{{ url('shipments/settings/emails/new') }}">{{ 'emails.emptyState.createOne'|t('shipments') }}</a>.</p>
	{% endif %}
	{% include 'shipments/_includes/plugin-footer' %}
{% endblock %}
